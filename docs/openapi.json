  "components": {
    "schemas": {
      "Execution": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "version": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Version"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Spans"
          },
          "fixture": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Fixture"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "spans"
        ],
        "title": "Execution"
      },
      "Fixture": {
        "properties": {
          "inventory_status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 200.0,
            "title": "Inventory Status"
          },
          "payment_status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 200.0,
            "title": "Payment Status"
          },
          "captured_checkout_status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 200.0,
            "title": "Captured Checkout Status"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "inventory_status",
          "payment_status",
          "captured_checkout_status",
          "quantity"
        ],
        "title": "Fixture"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReplayRequest": {
        "properties": {
          "execution_id": {
            "type": "string",
            "format": "uuid",
            "title": "Execution Id"
          },
          "expected_status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 200.0,
            "title": "Expected Status"
          },
          "inventory_status": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 599.0,
                "minimum": 200.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Inventory Status"
          },
          "payment_status": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 599.0,
                "minimum": 200.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Status"
          },
          "dependency_delay_ms": {
            "type": "integer",
            "maximum": 1500.0,
            "minimum": 0.0,
            "title": "Dependency Delay Ms",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "execution_id",
          "expected_status"
        ],
        "title": "ReplayRequest"
      },
      "Span": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Id"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "service": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,64}$",
            "title": "Service"
          },
          "operation": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Operation"
          },
          "start_ms": {
            "type": "integer",
            "maximum": 86400000.0,
            "minimum": 0.0,
            "title": "Start Ms"
          },
          "duration_ms": {
            "type": "integer",
            "maximum": 3600000.0,
            "minimum": 0.0,
            "title": "Duration Ms"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "http_status": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 599.0,
                "minimum": 100.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Http Status"
          },
          "attributes": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object",
            "maxProperties": 20,
            "title": "Attributes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "service",
          "operation",
          "start_ms",
          "duration_ms",
          "status"
        ],
        "title": "Span"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
